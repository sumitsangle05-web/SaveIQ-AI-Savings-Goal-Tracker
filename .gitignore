# SaveIQ .gitignore - Security & Secrets Protection

# Secrets & Environment variables
.env
.env.local
.env.*.local
*.env
*.key
*.pem
credentials.json
token.json
client_secrets.json

# Local databases & storage
*.db
*.sqlite
*.sqlite3
saveiq.db

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node / Clasp artifacts
node_modules/
.clasp.json
.claspignore

# OS & Editor temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
