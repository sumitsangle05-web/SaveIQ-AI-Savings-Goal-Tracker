# SaveIQ Backend Environment Variables

# Database Configuration
# Defaults to SQLite if empty: sqlite:///./saveiq.db
# For PostgreSQL / Supabase, use: postgresql://postgres:password@db.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./saveiq.db

# Groq API Configuration (Fast LLaMA 3.3-70B inference)
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: OpenAI API Key (Fallback if Groq is not used)
OPENAI_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
